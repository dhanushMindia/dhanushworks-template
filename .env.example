# ==============================================================================
# DHANUSHWORKS PORTFOLIO TEMPLATE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Follow the setup guide below to connect your independent Supabase project
# and Vercel deployment.
# ==============================================================================

# 1. Database (Supabase PostgreSQL Connection Strings)
# Transaction Pooler (Port 6543) with ?pgbouncer=true for app runtime queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Port 5432) for Prisma schema migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Authentication & Security
# Generate a secure random secret (e.g. using `openssl rand -base64 32`):
NEXTAUTH_SECRET="your-secure-random-jwt-secret-here"
NEXTAUTH_URL="http://localhost:3000" # Update to your production Vercel URL upon deployment

# 3. Admin Initial Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-admin-password"

# 4. S3-Compatible Object Storage (Supabase Storage / AWS S3 / Cloudflare R2)
# Required for media asset uploads in the CMS editor
S3_ENDPOINT="https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3"
S3_REGION="auto"
S3_BUCKET="portfolio-media"
S3_ACCESS_KEY="your-supabase-s3-access-key"
S3_SECRET_KEY="your-supabase-s3-secret-key"
S3_PUBLIC_URL="https://[YOUR-PROJECT-REF].supabase.co/storage/v1/object/public/portfolio-media"
